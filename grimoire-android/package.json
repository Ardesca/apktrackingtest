{
  "name": "grimoire-de-fer-android",
  "version": "1.0.0",
  "private": true,
  "description": "Grimoire de Fer - application Android (Capacitor)",
  "scripts": {
    "update-site": "rm -rf www && mkdir www && cp -r ../grimoire/public/. www/ && cap sync android",
    "sync": "cap sync android",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  }
}
